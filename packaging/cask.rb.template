# Homebrew cask template — CI generates the final cask from packaging/app.env on each release.
cask "{{CASK_NAME}}" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/{{GITHUB_OWNER}}/{{GITHUB_REPO}}/releases/download/v#{version}/{{APP_BUNDLE_NAME}}-#{version}.zip"
  name "{{APP_DISPLAY_NAME}}"
  desc "{{APP_DESCRIPTION}}"
  homepage "https://github.com/{{GITHUB_OWNER}}/{{GITHUB_REPO}}"

  auto_updates true
  depends_on macos: :sonoma

  app "{{APP_BUNDLE_NAME}}.app"

  # Releases are signed but not notarized (no paid Apple Developer account), so
  # clear the download quarantine to skip the "Apple could not verify" prompt.
  # Runs on the unpacked app before it is moved into place.
  preflight_steps do
    run "/usr/bin/xattr",
        args:           ["-dr", "com.apple.quarantine", "{{APP_BUNDLE_NAME}}.app"],
        chdir:          ".",
        writable_paths: ["{{APP_BUNDLE_NAME}}.app"]
  end

  zap trash: "~/Library/Application Support/{{APP_SUPPORT_DIR}}"

  caveats <<~EOS
    {{APP_DISPLAY_NAME}} needs Accessibility access to change mouse input:
      System Settings > Privacy & Security > Accessibility

    {{APP_DISPLAY_NAME}} can update itself (Settings > General > Updates).
    If upgrading from 0.1.x, remove the old entry from that list once and
    enable it again; later versions keep the permission.
  EOS
end
